---
import { experiences } from '../data/profile';
---
<section id="experiencia" class="section shell" aria-labelledby="experience-title">
  <div class="section-heading"><h2 id="experience-title">Experiencia</h2><p>Software que responde a una necesidad real.</p></div>
  <div class="experience-list">{experiences.map((experience) => <article class:list={['experience', { 'experience-current': experience.current }]}>
    <div class="experience-meta"><p class="period">{experience.current && <span class="current-dot" aria-hidden="true" />}{experience.period}</p><h3>{experience.company}</h3><p class="experience-role">{experience.role}</p>
      <a class="text-link project-link" href={experience.link.url} target="_blank" rel="noopener noreferrer">{experience.link.label}<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 4h9v9M16 4 5 15" /></svg></a></div>
    <div class="experience-body"><h4>{experience.summary}</h4><ul class="contributions">{experience.contributions.map((contribution) => <li>{contribution}</li>)}</ul><ul class="tags" aria-label="Tecnologías utilizadas">{experience.technologies.map((technology) => <li>{technology}</li>)}</ul></div>
  </article>)}</div>
</section>
