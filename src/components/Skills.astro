---
import { skillGroups } from '../data/profile';
---
<section id="skills" class="section skills-section" aria-labelledby="skills-title"><div class="shell skills-layout">
  <div class="section-heading"><h2 id="skills-title">Tecnologías</h2><p>Del código a la puesta<br class="desktop-break" /> en producción.</p></div>
  <dl class="skill-groups">{skillGroups.map((group) => <div class="skill-row"><dt>{group.category}</dt><dd>{group.skills.join(', ')}</dd></div>)}</dl>
</div></section>
